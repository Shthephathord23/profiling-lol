# Template for a new package (a workload to profile).
#
#   cp -r packages/_template packages/<name>
#
# The leading underscore keeps this directory out of discovery; a real
# package's name must match [a-z0-9][a-z0-9._-]* .
#
# This file is the last .env layer before the real process environment, so
# anything set here overrides both config.env and the profiler's own defaults.
# That is how a package tunes a profiler for itself.

# One line, shown by --list-packages.
PACKAGE_DESCRIPTION="One-line description of this workload"

# How the workload is launched:
#   python-module   PACKAGE_ENTRY is a module name       -> python -m <entry>
#   python-script   PACKAGE_ENTRY is a script path       -> python <entry>
#   exec            PACKAGE_ENTRY is an executable path  -> <entry>
PACKAGE_KIND=python-module

PACKAGE_ENTRY=my_package.cli
# Split with shlex.split, so normal shell quoting works.
PACKAGE_ARGS="--input data/sample.json --iterations 5"

# Working directory for every hook and for the workload itself.
PACKAGE_WORKDIR="$REPO_ROOT"

# Interpreter for the python-* kinds.  Defaults to python3.
# NOTE: interpreter-replacing profilers (viztracer, kernprof) run as whichever
# interpreter *they* were installed into, so make sure the workload is
# importable from both -- via PYTHONPATH, an installed package, or a venv
# created with --system-site-packages.
#PACKAGE_PYTHON="$REPO_ROOT/.venv/bin/python"

# Curated allowlist: which profilers make sense for this workload.
# Empty => DEFAULT_PROFILERS from config.env; if that is empty too, all of them.
# `--profiler all` expands to exactly this list.
PACKAGE_PROFILERS="time py-spy"

# 1 = call package_init once, before this package's runs.  0 or absent = a
# profiling run never builds this package.  `run_profiling.sh --init` builds it
# either way, so 0 does not mean "unbuildable", it means "not automatically".
#
# There is no staleness tracking: when this is 1 the hook runs on every
# invocation.  Making it cheap when there is nothing to do is the hook's job --
# see package.sh.  Only the package knows what "already built" means for it.
PACKAGE_INIT=0

# Seconds; 0 or empty means no timeout.  On expiry the whole process group is
# killed and the run is recorded as "timeout".
PACKAGE_TIMEOUT=600

# Dependencies for install.sh, discovered automatically.
PACKAGE_APT_PACKAGES=""
PACKAGE_PIP_PACKAGES=""

# Profiler-specific overrides go here too, e.g.:
#LINE_PROFILER_TARGETS="my_package.core"
#PYSPY_NATIVE=1        # this workload has C extensions
#VIZTRACER_MAX_DEPTH=32

# Profiler *declarations* -- PROFILER_KINDS, PROFILER_REQUIRES_BIN,
# PROFILER_FLAMEGRAPH -- are not tunable from here: they are read from the
# profiler on its own, before the package is layered on.  Setting one is an
# error rather than a silent no-op.

# Every layer is sourced with `set -a`, so anything this file assigns is
# exported into the profiled process -- including scratch variables.  Unset
# them if you use any:
#   for f in a b; do ...; done
#   unset f
