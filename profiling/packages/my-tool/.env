# Example package: a small, self-contained, offline workload that exercises
# every part of the harness.  Copy packages/_template to start a real one.

PACKAGE_DESCRIPTION="Example workload: normalise, score and checksum 2000 records"

PACKAGE_KIND=python-module
PACKAGE_ENTRY=my_tool.cli
PACKAGE_ARGS="--input data/sample.json --iterations 5"

# Self-contained: everything this package needs lives under its own directory,
# so the harness is runnable in a fresh checkout with no project around it.
MYTOOL_HOME="$PROFILING_ROOT/packages/my-tool"
PACKAGE_WORKDIR="$MYTOOL_HOME"

# package_init builds this virtualenv.
PACKAGE_PYTHON="$MYTOOL_HOME/.venv/bin/python"

# The workload is importable by *any* interpreter through PYTHONPATH, which
# matters because viztracer and kernprof run as the interpreter they were
# installed into rather than as PACKAGE_PYTHON.
PYTHONPATH="$MYTOOL_HOME/src${PYTHONPATH:+:$PYTHONPATH}"

PACKAGE_PROFILERS="time py-spy viztracer line-profiler"

# Re-run package_init whenever the workload's source changes.
PACKAGE_INIT_FINGERPRINT="src/my_tool/__init__.py src/my_tool/cli.py src/my_tool/core.py"

PACKAGE_TIMEOUT=600

PACKAGE_APT_PACKAGES=""
PACKAGE_PIP_PACKAGES=""

# line-profiler is the one profiler that needs telling what to look at.
LINE_PROFILER_TARGETS="my_tool.core"
