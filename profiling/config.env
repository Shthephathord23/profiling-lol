# Global configuration for the profiling harness.
#
# This file is sourced (with `set -a`) as the first environment layer of every
# run, so every assignment here is exported.  Every variable below uses the
# `: "${VAR:=default}"` idiom, which means an already-exported value from the
# real process environment wins -- see README.md, "Environment precedence".

# Absolute path to this profiling/ tree.  Resolved automatically; do not edit.
PROFILING_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Root of the project being profiled.  Package .env files reference this.
: "${REPO_ROOT:=$(cd "${PROFILING_ROOT}/.." && pwd)}"

# Where run artifacts are written.
: "${PROFILING_OUTPUT_DIR:=${PROFILING_ROOT}/output}"

# Where package init stamps are kept.
# Mount this as a volume to persist "already built" state across containers.
: "${PROFILING_STATE_DIR:=${PROFILING_ROOT}/.state}"

# Fallback profiler list, used when a package's PACKAGE_PROFILERS is empty.
: "${DEFAULT_PROFILERS:=time py-spy}"

# Default retention for --remove-output (runs kept per package/profiler pair).
: "${PROFILING_KEEP_DEFAULT:=1}"

# Global flamegraph kill switch (1 = allow profilers to emit flamegraphs).
# Set to 0 to make flamegraph-capable profilers degrade to a cheaper format.
: "${PROFILING_FLAMEGRAPHS:=1}"
