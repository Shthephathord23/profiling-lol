PROFILER_DESCRIPTION="Sampling profiler for Python (py-spy)"

PROFILER_KINDS="python-module python-script"

PROFILER_FLAMEGRAPH=1
PROFILER_FLAMEGRAPH_FILE="profile.svg"

PROFILER_REQUIRES_BIN="py-spy"
PROFILER_APT_PACKAGES=""
PROFILER_PIP_PACKAGES="py-spy"

# Samples per second.  100 is py-spy's own default and is cheap enough to
# leave on in CI; raise it for short workloads.
PYSPY_RATE=100

# One of: flamegraph, speedscope, raw, chrometrace.
PYSPY_FORMAT=flamegraph
PYSPY_EXT=svg

# Follow processes the workload spawns (multiprocessing pools, subprocesses).
PYSPY_SUBPROCESSES=1

# py-spy exits 0 even when the program it ran failed.  With this set to 1 the
# profiler recovers the workload's real exit code, so a failing run is
# reported as failed instead of silently passing.  See profiler.sh for how,
# and why it forces --subprocesses on.  Set to 0 for a plain invocation.
PYSPY_CAPTURE_EXIT_CODE=1

# Set to 1 for packages with C/Cython extensions to get native frames.
PYSPY_NATIVE=0

# Used when PROFILING_FLAMEGRAPHS=0: py-spy degrades to this format rather
# than failing, so the global kill switch never breaks a run.
PYSPY_FALLBACK_FORMAT=speedscope
PYSPY_FALLBACK_EXT=json
