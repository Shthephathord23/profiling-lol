# Template for a new profiler.
#
#   cp -r profilers/_template profilers/<name>
#
# The leading underscore keeps this directory out of discovery; a real
# profiler's name must match [a-z0-9][a-z0-9._-]* .
#
# This file is sourced by bash between config.env and the package .env, so a
# package can override any knob you define here for itself.

# One line, shown by --list-profilers.
PROFILER_DESCRIPTION="One-line description of what this profiler measures"

# Which PACKAGE_KINDs this profiler can handle.  A package whose kind is not
# listed is skipped (informational, never a failure).
#   python-module   python -m <module>
#   python-script   python <script.py>
#   exec            a plain executable, no interpreter
# Prefix wrappers can usually claim all three; anything that replaces the
# Python interpreter must not claim `exec`.
PROFILER_KINDS="python-module python-script"

# 1 if this profiler can emit a flamegraph.
PROFILER_FLAMEGRAPH=0
# Path relative to RUN_DIR, recorded in meta.json when it exists.
PROFILER_FLAMEGRAPH_FILE=""

# Space-separated binaries checked by `install.sh --check` and by the harness
# before each run.  Absolute paths are tested with -x, bare names with PATH.
PROFILER_REQUIRES_BIN=""

# Dependencies.  install.sh discovers these automatically -- there is no list
# to update elsewhere.
PROFILER_APT_PACKAGES=""
PROFILER_PIP_PACKAGES=""

# Optional: warn when a package selects this profiler without configuring it.
# Space-separated variable names; the message is appended to the warning.
#PROFILER_WARN_IF_UNSET="MYTOOL_TARGETS"
#PROFILER_WARN_MESSAGE="set MYTOOL_TARGETS in the package .env"

# Tool-specific knobs.  Prefix them with the tool name so a package can
# override them unambiguously.
#MYTOOL_RATE=100
#MYTOOL_OUTPUT="profile.out"
