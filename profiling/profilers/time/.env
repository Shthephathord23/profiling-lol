PROFILER_DESCRIPTION="Wall clock, CPU time and peak RSS (GNU time)"

# The only profiler that works for every package kind, including exec.
PROFILER_KINDS="python-module python-script exec"

PROFILER_FLAMEGRAPH=0
PROFILER_FLAMEGRAPH_FILE=""

PROFILER_REQUIRES_BIN="/usr/bin/time"
PROFILER_APT_PACKAGES="time"
PROFILER_PIP_PACKAGES=""

# -v is GNU time's verbose report (max RSS, page faults, context switches).
# The shell builtin `time` does not support -o/-v, hence the absolute path.
TIME_BIN="/usr/bin/time"
TIME_FLAGS="-v"
TIME_OUTPUT="time.txt"
