PROFILER_DESCRIPTION="Line-by-line timings inside chosen modules (kernprof)"

PROFILER_KINDS="python-module python-script"

PROFILER_FLAMEGRAPH=0
PROFILER_FLAMEGRAPH_FILE=""

PROFILER_REQUIRES_BIN="kernprof"
PROFILER_APT_PACKAGES=""
PROFILER_PIP_PACKAGES="line_profiler"

# The one profiler that is not zero-config: with no targets and no @profile
# decorators in the source, kernprof produces an empty report.  The harness
# warns (never fails) when a package selects it without setting this.
PROFILER_WARN_IF_UNSET="LINE_PROFILER_TARGETS"
PROFILER_WARN_MESSAGE="the report will be empty unless the source uses @profile decorators; set LINE_PROFILER_TARGETS in the package .env"

# Comma-separated modules/functions/classes to profile, e.g. "my_tool.core".
# kernprof's -p/--prof-mod accepts a comma-separated list (line_profiler >=4.1).
# Set this per package, not here.
LINE_PROFILER_TARGETS=""

LINE_PROFILER_OUTPUT="out.lprof"
LINE_PROFILER_REPORT="report.txt"

# Eagerly import and instrument the -p targets even when the profiled code
# only imports them indirectly.
LINE_PROFILER_PREIMPORTS=1
