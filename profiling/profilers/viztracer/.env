PROFILER_DESCRIPTION="Deterministic tracer producing a timeline (viztracer)"

PROFILER_KINDS="python-module python-script"

# viztracer emits a timeline trace, not a flamegraph; view it with
#   vizviewer <RUN_DIR>/trace.json
PROFILER_FLAMEGRAPH=0
PROFILER_FLAMEGRAPH_FILE=""

PROFILER_REQUIRES_BIN="viztracer"
PROFILER_APT_PACKAGES=""
PROFILER_PIP_PACKAGES="viztracer"

# Traces are large -- viztracer records every call, and the defaults produce
# ~100 MB from a workload that runs for a fraction of a second.  Two knobs keep
# that in check; both are conservative on purpose.  See README.md
# ("Artifact sizes") before raising either in CI.
#
# Maximum call depth recorded.
VIZTRACER_MAX_DEPTH=64
# Size of the circular event buffer.  viztracer's own default is 1000000,
# which is roughly 100 MB of JSON; this keeps a run near 20 MB.  The buffer is
# circular, so overflowing it costs you the *earliest* events, not the run.
VIZTRACER_TRACER_ENTRIES=200000

VIZTRACER_OUTPUT="trace.json"

# Extra flags appended verbatim, e.g. "--ignore_c_function --min_duration 10us".
VIZTRACER_FLAGS=""
